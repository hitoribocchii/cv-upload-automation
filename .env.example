# ---- OAuth de Google (los genera el dueño de la cuenta, una sola vez) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# El refresh token tambien lo completa "npm run token".
GOOGLE_REFRESH_TOKEN=

# ID de la carpeta de Drive donde caen los CVs. LO COMPLETA SOLO "npm run token",
# que crea la carpeta. No uses una carpeta creada a mano: con el scope
# drive.file la app no puede escribir ahi (da 404).
DRIVE_FOLDER_ID=

# ---- Anti-spam (opcional pero MUY recomendado en un form publico) ----
# Cloudflare Turnstile, gratis: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Configuracion ----
# Aceptar .docx ademas de PDF. Por defecto solo PDF (ver README).
ALLOW_DOCX=true
# Nombre del comercio / sucursal, se muestra en la pagina
NEXT_PUBLIC_BRANCH_NAME=Sucursal Centro
NEXT_PUBLIC_COMPANY_NAME=Comercio Ejemplo
# A quien reclaman los postulantes por sus datos (Ley 25.326)
NEXT_PUBLIC_CONTACT_EMAIL=rrhh@ejemplo.com
